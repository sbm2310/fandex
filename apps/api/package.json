{
  "name": "@fandex/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fandex backend: NestJS REST API (accounts, catalog, collection).",
  "type": "module",
  "scripts": {
    "prebuild": "npm run build -w @fandex/core",
    "build": "nest build",
    "predev": "npm run build -w @fandex/core",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && vitest run --config vitest.config.e2e.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fandex/core": "*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "globals": "^16.5.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "vitest": "^4.1.2"
  }
}
