# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
# Local PostgreSQL from docker-compose.yml (`npm run db:up`); dev-only credentials.
DATABASE_URL=postgresql://fandex:fandex@localhost:5432/fandex
# Signs session tokens. Generate your own: `openssl rand -base64 32`. Never commit a real one.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Web app origins allowed to call auth routes (comma-separated).
TRUSTED_ORIGINS=http://localhost:8081
