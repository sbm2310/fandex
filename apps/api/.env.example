# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
# Local PostgreSQL from docker-compose.yml (`npm run db:up`); dev-only credentials.
DATABASE_URL=postgresql://fandex:fandex@localhost:5432/fandex
# Signs session tokens. Generate your own: `openssl rand -base64 32`. Never commit a real one.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Origins allowed to call the API with a session (comma-separated): web app + app scheme.
TRUSTED_ORIGINS=http://localhost:8081,fandex://
# LEGO search (optional): free key from https://rebrickable.com/users/settings/#api
REBRICKABLE_API_KEY=
# AI features (optional): free key from https://console.groq.com/keys (no card). Without it,
# shelf scanning answers 503. Turn on Zero Data Retention in Groq's Data Controls.
GROQ_API_KEY=
# Which provider reads shelf photos: groq (default), gemini-free or gemini (paid, prepaid
# credit). See src/ai/ai-providers.ts and docs/eval/shelf-recognition.md.
# AI_PROVIDER=groq
# Google AI Studio key, for gemini-free / gemini (also used by eval:shelf --provider gemini).
# GEMINI_API_KEY=
# Which provider turns "Ask" questions into queries (text only; groq by default).
# AI_ASK_PROVIDER=groq
# Overrides of the shelf provider's endpoint and model.
# AI_BASE_URL=
# AI_VISION_MODEL=
# Daily shelf scans per user, and for everyone together (UTC days). Gemini's free tier
# allows 20 requests a day in total.
# AI_SHELF_SCANS_PER_USER=5
# AI_SHELF_SCANS_PER_DAY=30
# "Ask" questions answered by the AI per user, and for everyone (keywords answer beyond that).
# AI_QUESTIONS_PER_USER=30
# AI_QUESTIONS_PER_DAY=100
# Evaluation only (npm run eval:shelf -- --provider mistral); not used by the API.
# MISTRAL_API_KEY=
