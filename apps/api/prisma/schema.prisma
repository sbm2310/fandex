// Fandex database schema. Models use TypeScript-style names; tables and columns are
// snake_case in PostgreSQL via @@map / @map.
// After changing this file: `npm run db:migrate -- --name <change>` (creates a migration).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // The API is an ESM/nodenext project, so generated imports need .js extensions.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  book
  manga
  comic
  lego
  figure
}

enum CatalogSource {
  openlibrary
  rebrickable
  /// Added by hand by its owner (figures); private to them.
  custom
  /// Fandex's own curated figure catalog (`@fandex/core/figure-seed`); shared by everyone.
  fandex
}

/// A catalog entry fetched from an external source and cached here, shared by all users.
model CatalogItem {
  id               String            @id @default(uuid(7)) @db.Uuid
  category         Category
  source           CatalogSource
  externalId       String            @map("external_id")
  title            String
  subtitle         String?
  creators         String[]
  year             Int?
  /// Books: the edition's publication date (first day of its period) and how precise it is.
  /// For an upcoming edition it's the expected release, offered to pre-orders.
  publishDate      DateTime?         @map("publish_date") @db.Date
  publishPrecision ReleasePrecision? @map("publish_precision")
  publisher        String?
  isbn13           String?           @db.Char(13)
  setNumber        String?           @map("set_number")
  pieceCount       Int?              @map("piece_count")
  coverUrl         String?           @map("cover_url")
  /// LEGO: top-level theme ("Star Wars") and sub-theme.
  theme            String?
  subtheme         String?
  /// Figures: "1/6".
  scale            String?
  /// Figures: the number on the box, written our way ("MMS 649").
  figureNumber     String?           @map("figure_number")
  /// Figures: "Deluxe", "Premium"…
  edition          String?
  /// Figures: when it came out or is expected (first day of the period) and how precise that is.
  releaseDate      DateTime?         @map("release_date") @db.Date
  releasePrecision ReleasePrecision? @map("release_precision")
  /// Figures: the original retail price, in minor units (cents) of `priceCurrency`.
  priceAmount      Int?              @map("price_amount")
  priceCurrency    String?           @map("price_currency") @db.Char(3)
  /// Curated figures: the pages their facts were checked against.
  sources          String[]          @default([])
  /// Custom items only: the user who added it (only they can see or own it).
  ownerId          String?           @map("owner_id") @db.Uuid
  owner            User?             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Open Library work id ("OL27482W"): the same book in any edition.
  workKey          String?           @map("work_key")
  /// What the source says about the item's fiction (characters, places, LEGO themes and
  /// minifigs), for universe matching. Shape: MatchSignals in @fandex/core. Null = not fetched.
  matchSignals     Json?             @map("match_signals")
  fetchedAt        DateTime          @default(now()) @map("fetched_at") @db.Timestamptz
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  ownedBy           CollectionItem[]
  preorders         Preorder[]
  /// A private figure suggested for the shared catalog (kept after approval).
  suggestion        FigureSuggestion?      @relation("SuggestedFigure")
  /// Suggestions merged into this shared figure.
  mergedSuggestions FigureSuggestion[]     @relation("MergedInto")
  universes         CatalogItemUniverse[]
  characters        CatalogItemCharacter[]

  @@unique([source, externalId])
  @@index([isbn13])
  @@index([workKey])
  @@index([ownerId])
  @@index([figureNumber])
  @@map("catalog_item")
}

/// A copy a user owns. Deleted with the user; a catalog entry can't be deleted while owned.
model CollectionItem {
  id               String      @id @default(uuid(7)) @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItemId    String      @map("catalog_item_id") @db.Uuid
  // NoAction, not Restrict: still can't delete an owned catalog item, but the check runs at the
  // end of the statement, so deleting a user removes their custom items and copies together.
  catalogItem      CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: NoAction)
  addedAt          DateTime    @default(now()) @map("added_at") @db.Timestamptz
  notes            String?
  /// The user's correction of the catalog's category (books only); null = the catalog's.
  categoryOverride Category?   @map("category_override")
  /// The user's fixes to the automatic universe links (LinkEdits in @fandex/core); null = none.
  linkEdits        Json?       @map("link_edits")

  // Each edition once per user (ownership is per edition).
  @@unique([userId, catalogItemId])
  // "My collection, newest first".
  @@index([userId, addedAt(sort: Desc)])
  @@map("collection_item")
}

// ── Accounts (Better Auth) ──────────────────────────────────────────────────────────────
// Field names follow Better Auth's core schema (`npx auth generate`). With
// advanced.database.generateId: 'uuid', Better Auth leaves ids to the database layer, so each
// id defaults to a time-ordered UUIDv7 generated by Prisma.

model User {
  id                String             @id @default(uuid(7)) @db.Uuid
  name              String
  email             String             @unique
  emailVerified     Boolean            @default(false) @map("email_verified")
  image             String?
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  sessions          Session[]
  accounts          Account[]
  collection        CollectionItem[]
  aiUsage           AiUsage[]
  customItems       CatalogItem[]
  preorders         Preorder[]
  figureSuggestions FigureSuggestion[]

  @@map("user")
}

/// A signed-in device or browser. Deleted with its user.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// A way to sign in: "credential" (email + password, hashed) now, Apple/Google later.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId])
  @@map("account")
}

/// Short-lived tokens (email verification, password reset).
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
  @@map("verification")
}

/// A fictional universe from the curated seed (UNIVERSE_SEED in @fandex/core), synced on start.
model Universe {
  id          String @id @default(uuid(7)) @db.Uuid
  slug        String @unique
  name        String
  description String
  wikidataId  String @map("wikidata_id")
  /// Order in the seed (lists are shown in this order).
  position    Int

  characters   Character[]
  catalogItems CatalogItemUniverse[]

  @@map("universe")
}

/// A character in a universe, from the seed.
model Character {
  id         String   @id @default(uuid(7)) @db.Uuid
  universeId String   @map("universe_id") @db.Uuid
  slug       String
  name       String
  aliases    String[]
  wikidataId String   @map("wikidata_id")
  position   Int

  universe     Universe               @relation(fields: [universeId], references: [id], onDelete: Cascade)
  catalogItems CatalogItemCharacter[]

  @@unique([universeId, slug])
  @@map("character")
}

/// Automatic link: a catalog item belongs to a universe (computed by matchUniverses).
model CatalogItemUniverse {
  catalogItemId String @map("catalog_item_id") @db.Uuid
  universeId    String @map("universe_id") @db.Uuid

  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  universe    Universe    @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@id([catalogItemId, universeId])
  @@index([universeId])
  @@map("catalog_item_universe")
}

/// Automatic link: a character appears in a catalog item.
model CatalogItemCharacter {
  catalogItemId String @map("catalog_item_id") @db.Uuid
  characterId   String @map("character_id") @db.Uuid

  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  character   Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([catalogItemId, characterId])
  @@index([characterId])
  @@map("catalog_item_character")
}

/// Bookkeeping for startup tasks: which version of something was last applied (e.g. the seed).
model SyncState {
  name     String   @id
  hash     String
  syncedAt DateTime @default(now()) @map("synced_at") @db.Timestamptz

  @@map("sync_state")
}

enum AiUsageKind {
  shelf_scan
  question
  figure_scan
}

/// How many AI requests a user made on a day (UTC), for quotas. Nothing about the request
/// itself (photo, question) is stored.
model AiUsage {
  userId String      @map("user_id") @db.Uuid
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime    @db.Date
  kind   AiUsageKind
  count  Int         @default(0)

  @@id([userId, day, kind])
  // "Everyone's scans today", for the global daily limit.
  @@index([day, kind])
  @@map("ai_usage")
}

enum PreorderStatus {
  ordered
  arrived
  cancelled
}

/// How precise an expected release is: stores announce a day, a month, a quarter or a year.
enum ReleasePrecision {
  day
  month
  quarter
  year
}

enum DateChangeSource {
  user
  openlibrary
}

/// Something the user has on order. Money is in minor units (cents) of `currency`.
model Preorder {
  id                 String            @id @default(uuid(7)) @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItemId      String            @map("catalog_item_id") @db.Uuid
  // NoAction like collection_item: an item can't be deleted while pre-ordered, but a user's
  // custom items and pre-orders go together when the account is deleted.
  catalogItem        CatalogItem       @relation(fields: [catalogItemId], references: [id], onDelete: NoAction)
  status             PreorderStatus    @default(ordered)
  currency           String            @db.Char(3)
  price              Int?
  paid               Int               @default(0)
  balanceDueDate     DateTime?         @map("balance_due_date") @db.Date
  /// The expected release: the first day of its period, and how precise it is.
  releaseDate        DateTime?         @map("release_date") @db.Date
  releasePrecision   ReleasePrecision? @map("release_precision")
  /// The expected release is the catalog's (Open Library's) date, so it moves when that does.
  /// Set when the dates match at creation or after the user's own change.
  followsCatalogDate Boolean           @default(false) @map("follows_catalog_date")
  store              String?
  orderNumber        String?           @map("order_number")
  orderUrl           String?           @map("order_url")
  notes              String?
  arrivedAt          DateTime?         @map("arrived_at") @db.Timestamptz
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  dateChanges PreorderDateChange[]

  @@index([userId])
  @@index([catalogItemId])
  @@map("preorder")
}

/// One change of a pre-order's expected release, so slips stay visible.
model PreorderDateChange {
  id            String            @id @default(uuid(7)) @db.Uuid
  preorderId    String            @map("preorder_id") @db.Uuid
  preorder      Preorder          @relation(fields: [preorderId], references: [id], onDelete: Cascade)
  fromDate      DateTime?         @map("from_date") @db.Date
  fromPrecision ReleasePrecision? @map("from_precision")
  toDate        DateTime?         @map("to_date") @db.Date
  toPrecision   ReleasePrecision? @map("to_precision")
  source        DateChangeSource
  changedAt     DateTime          @default(now()) @map("changed_at") @db.Timestamptz

  @@index([preorderId, changedAt])
  @@map("preorder_date_change")
}

/// A book series from Wikidata (Stage 6), cached: its main line and extras as stored JSON
/// (BookSeries in @fandex/core; validated on read). Shared by all users.
model Series {
  wikidataId String   @id @map("wikidata_id")
  name       String
  /// SeriesEntry[]: the main line, in order.
  entries    Json
  /// SeriesEntry[]: novellas, companions, unnumbered books.
  extras     Json
  fetchedAt  DateTime @default(now()) @map("fetched_at") @db.Timestamptz

  works WorkSeries[]

  @@map("series")
}

/// Which series an Open Library work belongs to, as Wikidata said when last asked (null: none).
/// Every work of a fetched series is recorded too, so one query answers for the whole series.
model WorkSeries {
  workKey          String   @id @map("work_key")
  seriesWikidataId String?  @map("series_wikidata_id")
  series           Series?  @relation(fields: [seriesWikidataId], references: [wikidataId], onDelete: SetNull)
  checkedAt        DateTime @default(now()) @map("checked_at") @db.Timestamptz

  @@index([seriesWikidataId])
  @@map("work_series")
}

enum FigureSuggestionStatus {
  pending
  approved
  merged
  rejected
}

/// A user's private figure suggested for the shared catalog, and what the reviewer decided.
model FigureSuggestion {
  id            String                 @id @default(uuid(7)) @db.Uuid
  userId        String                 @map("user_id") @db.Uuid
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The suggested figure. Deleting it (its owner removed it) withdraws the suggestion; null
  /// once it was merged (the private copy is gone).
  catalogItemId String?                @unique @map("catalog_item_id") @db.Uuid
  catalogItem   CatalogItem?           @relation("SuggestedFigure", fields: [catalogItemId], references: [id], onDelete: Cascade)
  /// Merged: the shared figure the suggester's collection and pre-orders now point to.
  mergedIntoId  String?                @map("merged_into_id") @db.Uuid
  mergedInto    CatalogItem?           @relation("MergedInto", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  status        FigureSuggestionStatus @default(pending)
  /// The suggester's note to the reviewer.
  note          String?
  /// The reviewer's note (why it was rejected).
  reviewNote    String?                @map("review_note")
  reviewedAt    DateTime?              @map("reviewed_at") @db.Timestamptz
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, createdAt])
  @@index([userId])
  @@map("figure_suggestion")
}
