// Fandex database schema. Models use TypeScript-style names; tables and columns are
// snake_case in PostgreSQL via @@map / @map.
// After changing this file: `npm run db:migrate -- --name <change>` (creates a migration).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // The API is an ESM/nodenext project, so generated imports need .js extensions.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  book
  manga
  comic
  lego
}

enum CatalogSource {
  openlibrary
  rebrickable
}

/// A catalog entry fetched from an external source and cached here, shared by all users.
model CatalogItem {
  id           String        @id @default(uuid(7)) @db.Uuid
  category     Category
  source       CatalogSource
  externalId   String        @map("external_id")
  title        String
  subtitle     String?
  creators     String[]
  year         Int?
  publisher    String?
  isbn13       String?       @db.Char(13)
  setNumber    String?       @map("set_number")
  pieceCount   Int?          @map("piece_count")
  coverUrl     String?       @map("cover_url")
  /// LEGO: top-level theme ("Star Wars") and sub-theme.
  theme        String?
  subtheme     String?
  /// Open Library work id ("OL27482W"): the same book in any edition.
  workKey      String?       @map("work_key")
  /// What the source says about the item's fiction (characters, places, LEGO themes and
  /// minifigs), for universe matching. Shape: MatchSignals in @fandex/core. Null = not fetched.
  matchSignals Json?         @map("match_signals")
  fetchedAt    DateTime      @default(now()) @map("fetched_at") @db.Timestamptz
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  ownedBy    CollectionItem[]
  universes  CatalogItemUniverse[]
  characters CatalogItemCharacter[]

  @@unique([source, externalId])
  @@index([isbn13])
  @@index([workKey])
  @@map("catalog_item")
}

/// A copy a user owns. Deleted with the user; a catalog entry can't be deleted while owned.
model CollectionItem {
  id               String      @id @default(uuid(7)) @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItemId    String      @map("catalog_item_id") @db.Uuid
  catalogItem      CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  addedAt          DateTime    @default(now()) @map("added_at") @db.Timestamptz
  notes            String?
  /// The user's correction of the catalog's category (books only); null = the catalog's.
  categoryOverride Category?   @map("category_override")
  /// The user's fixes to the automatic universe links (LinkEdits in @fandex/core); null = none.
  linkEdits        Json?       @map("link_edits")

  // Each edition once per user (ownership is per edition).
  @@unique([userId, catalogItemId])
  // "My collection, newest first".
  @@index([userId, addedAt(sort: Desc)])
  @@map("collection_item")
}

// ── Accounts (Better Auth) ──────────────────────────────────────────────────────────────
// Field names follow Better Auth's core schema (`npx auth generate`). With
// advanced.database.generateId: 'uuid', Better Auth leaves ids to the database layer, so each
// id defaults to a time-ordered UUIDv7 generated by Prisma.

model User {
  id            String           @id @default(uuid(7)) @db.Uuid
  name          String
  email         String           @unique
  emailVerified Boolean          @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  sessions      Session[]
  accounts      Account[]
  collection    CollectionItem[]
  aiUsage       AiUsage[]

  @@map("user")
}

/// A signed-in device or browser. Deleted with its user.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// A way to sign in: "credential" (email + password, hashed) now, Apple/Google later.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId])
  @@map("account")
}

/// Short-lived tokens (email verification, password reset).
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
  @@map("verification")
}

/// A fictional universe from the curated seed (UNIVERSE_SEED in @fandex/core), synced on start.
model Universe {
  id          String @id @default(uuid(7)) @db.Uuid
  slug        String @unique
  name        String
  description String
  wikidataId  String @map("wikidata_id")
  /// Order in the seed (lists are shown in this order).
  position    Int

  characters   Character[]
  catalogItems CatalogItemUniverse[]

  @@map("universe")
}

/// A character in a universe, from the seed.
model Character {
  id         String   @id @default(uuid(7)) @db.Uuid
  universeId String   @map("universe_id") @db.Uuid
  slug       String
  name       String
  aliases    String[]
  wikidataId String   @map("wikidata_id")
  position   Int

  universe     Universe               @relation(fields: [universeId], references: [id], onDelete: Cascade)
  catalogItems CatalogItemCharacter[]

  @@unique([universeId, slug])
  @@map("character")
}

/// Automatic link: a catalog item belongs to a universe (computed by matchUniverses).
model CatalogItemUniverse {
  catalogItemId String @map("catalog_item_id") @db.Uuid
  universeId    String @map("universe_id") @db.Uuid

  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  universe    Universe    @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@id([catalogItemId, universeId])
  @@index([universeId])
  @@map("catalog_item_universe")
}

/// Automatic link: a character appears in a catalog item.
model CatalogItemCharacter {
  catalogItemId String @map("catalog_item_id") @db.Uuid
  characterId   String @map("character_id") @db.Uuid

  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  character   Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([catalogItemId, characterId])
  @@index([characterId])
  @@map("catalog_item_character")
}

/// Bookkeeping for startup tasks: which version of something was last applied (e.g. the seed).
model SyncState {
  name     String   @id
  hash     String
  syncedAt DateTime @default(now()) @map("synced_at") @db.Timestamptz

  @@map("sync_state")
}

enum AiUsageKind {
  shelf_scan
  question
}

/// How many AI requests a user made on a day (UTC), for quotas. Nothing about the request
/// itself (photo, question) is stored.
model AiUsage {
  userId String      @map("user_id") @db.Uuid
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime    @db.Date
  kind   AiUsageKind
  count  Int         @default(0)

  @@id([userId, day, kind])
  // "Everyone's scans today", for the global daily limit.
  @@index([day, kind])
  @@map("ai_usage")
}
