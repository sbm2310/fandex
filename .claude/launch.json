{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:api"],
      "port": 3000
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web", "-w", "@fandex/mobile", "--", "--port", "8081"],
      "env": {
        "BROWSER": "none"
      },
      "port": 8081
    },
    {
      "name": "mobile-ios",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "-w", "@fandex/mobile", "--", "--port", "8082"],
      "port": 8082
    }
  ]
}
